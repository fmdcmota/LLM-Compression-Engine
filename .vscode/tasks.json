{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-w",
                "-fopenmp",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-I${workspaceFolder}/llama.cpp/include",
                "-I${workspaceFolder}/llama.cpp/ggml/include",
                "${workspaceFolder}/llama.cpp/build-linux/src/libllama.a",
                "${workspaceFolder}/llama.cpp/build-linux/ggml/src/libggml.a",
                "${workspaceFolder}/llama.cpp/build-linux/ggml/src/libggml-cpu.a",
                "${workspaceFolder}/llama.cpp/build-linux/ggml/src/libggml-base.a",
                "-lpthread",
                "-lm",
                "-ldl"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}